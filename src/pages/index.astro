---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Frame from '../components/Frame.astro';
import { projects } from '../data/projects';
import { site } from '../data/site';
import { image } from '../lib/images';
import { url } from '../lib/url';
---

<Base>
  <Hero src={image('PRO01', '07')} alt="Double-height living room with a sculptural ring chandelier" focus="30%">
    <p class="eyebrow eyebrow--light">{site.tagline}</p>
    <h1 class="hero__title hero__title--xl">{site.name}</h1>
  </Hero>

  <section class="statement" id="studio">
    <p class="eyebrow" data-fade>Studio</p>
    <p class="statement__text" data-fade>{site.statement}</p>
  </section>

  <section class="work" id="work">
    <header class="work__head">
      <p class="eyebrow" data-fade>Selected work</p>
      <h2 class="work__title" data-depth="-0.08">Projects</h2>
    </header>

    {
      projects.map((project, i) => (
        <a
          class:list={['work__item', { 'is-flip': i % 2 === 1 }]}
          href={url(`projects/${project.slug}/`)}
          style={`--accent: ${project.accent}`}
        >
          <div class="work__media">
            <Frame
              src={image(project.code, project.cover)}
              alt={`${project.title} — cover`}
              sizes="(min-width: 900px) 42vw, 80vw"
              class="work__cover"
              depth={-0.04}
              zoom={false}
            />
            <Frame
              src={image(project.code, project.coverDetail)}
              alt={`${project.title} — detail`}
              sizes="(min-width: 900px) 22vw, 50vw"
              class="work__detail"
              depth={0.18}
              zoom={false}
            />
          </div>
          <div class="work__text" data-fade>
            <span class="work__num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="work__name">{project.title}</h3>
            <p class="work__meta">{project.subtitle} · {project.location} · {project.year}</p>
            <span class="work__cta">View project →</span>
          </div>
        </a>
      ))
    }
  </section>
</Base>
