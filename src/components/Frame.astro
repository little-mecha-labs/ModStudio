---
// An image inside a clipping frame. The image drifts inside the frame as
// you scroll (data-inner) and the whole frame can move at its own speed
// (depth: positive = faster / closer, negative = slower / further).
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  depth?: number;
  class?: string;
  band?: boolean;
  focus?: string;
  zoom?: boolean;
}

const { src, alt, sizes, depth, class: className, band = false, focus, zoom = true } = Astro.props;
const full = zoom ? await getImage({ src, width: 2000, format: 'webp' }) : null;
---

<figure
  class:list={['frame', { 'frame--band': band }, className]}
  data-depth={depth}
  data-reveal
>
  <div class="frame__clip">
    <Image
      src={src}
      alt={alt}
      widths={[480, 800, 1200, 1600, 2000]}
      sizes={sizes}
      class="frame__img"
      data-inner
      loading="eager"
      style={focus ? `object-position: 50% ${focus}` : undefined}
    />
  </div>
  {full && <button class="frame__zoom" type="button" data-full={full.src} data-alt={alt} aria-label={`View ${alt} full screen`}></button>}
</figure>
